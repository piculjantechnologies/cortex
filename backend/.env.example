# Cortex backend configuration template.
#
#   cp .env.example .env
#
# `flask --app run ...` and `python run.py` load .env when python-dotenv is
# installed (it is in requirements-dev.txt). gunicorn in production installs
# only requirements.txt, so there the variables come from the process
# environment (for example a systemd EnvironmentFile), not from this file.
# The offline pipeline never reads .env: export its variables in the shell.
#
# REQUIRED variables must be set and non-blank, otherwise the app refuses to
# start and the error names every missing one. Optional variables are
# commented out; the comment above each states its default (some lines show
# the value to use for local development, or an example, instead). All values
# here are placeholders. Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# Web app (Flask, gunicorn run:app)
# ---------------------------------------------------------------------------

# REQUIRED. Signs session cookies and password-reset links. Use a long random
# value that stays the same across restarts and all gunicorn workers, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# REQUIRED. Public origin of the SPA, without a path. It is the only origin
# CORS allows and the base of the reset link (<FRONTEND_URL>/reset-password/...).
# A trailing slash is stripped. Local development: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# REQUIRED. MySQL database for the user accounts (driver: PyMySQL).
# The password may contain any characters; it is escaped when the URL is built.
DB_HOST=127.0.0.1
DB_NAME=cortex
DB_USER=cortex
DB_PASSWORD=

# Optional, default 3306.
# DB_PORT=3306

# Optional, default unset (no TLS). Path to a CA certificate file; when set,
# the MySQL connection uses TLS verified against it.
# DB_SSL_CA=/path/to/ca.pem

# REQUIRED. MongoDB connection string for the image collection (the same
# database the pipeline fills). The older name mongo_db_uri is still read
# when MONGO_URI is unset, with a deprecation warning; use MONGO_URI.
MONGO_URI=mongodb://localhost:27017

# Optional, defaults "cortex" and "collection".
# MONGO_DB=cortex
# MONGO_COLLECTION=collection

# REQUIRED. Stripe secret API key (Dashboard > Developers > API keys).
STRIPE_API_KEY=

# REQUIRED. Price id of the subscription plan offered at checkout.
STRIPE_PRICE_ID=

# REQUIRED. Signing secret of the webhook endpoint that points at /api/webhook.
# For local development, `stripe listen --forward-to localhost:5000/api/webhook`
# prints one.
STRIPE_WEBHOOK_SECRET=

# REQUIRED. Where Stripe sends the user after checkout (the app appends
# ?session_id=..., so give a URL without a query string) and where the billing
# portal returns to. Normally <FRONTEND_URL>/dashboard.
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard

# REQUIRED. Where Stripe sends the user when checkout is cancelled.
STRIPE_CANCEL_URL=http://localhost:3000/dashboard

# REQUIRED. Mailgun sending domain and API key, used for password-reset emails
# (sent through the api.mailgun.net endpoint, from mailgun@<MAILGUN_DOMAIN>).
MAILGUN_DOMAIN=
MAILGUN_API_KEY=

# REQUIRED. OAuth client id of the Google Identity Services web client
# (....apps.googleusercontent.com). Google ID tokens must be issued to it.
# The frontend's REACT_APP_GOOGLE_CLIENT_ID must be the same value.
GOOGLE_CLIENT_ID=

# Optional, default 1 (cookies are Secure: sent over HTTPS only). Set 0 only
# for local development over plain http, otherwise the browser drops the login
# cookies.
# COOKIE_SECURE=0

# Optional, default 1: the number of reverse proxies in front of gunicorn whose
# X-Forwarded-For entry is trusted for the client address (rate limits are per
# client address). Set 0 when clients reach gunicorn or the dev server directly.
# TRUSTED_PROXY_COUNT=1

# Optional, default memory://. Storage for the rate-limit counters. memory://
# counts separately in every gunicorn worker (and resets on restart); a shared
# store such as redis://host:6379 also needs the `redis` Python package installed.
# RATELIMIT_STORAGE_URI=memory://

# Optional, default 100000 (must be at least 1). Maximum rows in one CSV export.
# EXPORT_MAX_ROWS=100000

# Optional, defaults 10000 and 300000 (milliseconds, at least 1). MongoDB time
# limits of one search page and of one CSV export; a search that runs longer
# answers 504 and asks the user to narrow it.
# QUERY_MAX_TIME_MS=10000
# EXPORT_MAX_TIME_MS=300000

# Optional, default off. FLASK_DEBUG=1 turns on debug mode (auto-reload) for
# `python run.py` and `flask --app run run`; tracebacks go to the server log.
# Never set it in production.
# FLASK_DEBUG=1

# ---------------------------------------------------------------------------
# Offline pipeline (python -m pipeline.<module>); export these in the shell.
# It also reads MONGO_URI, MONGO_DB and MONGO_COLLECTION from above.
# ---------------------------------------------------------------------------

# REQUIRED for download_commoncrawl and process_commoncrawl (unless
# --connect-str is given). Azure Storage connection string of the account that
# holds the Common Crawl index files. The older name connect_str is still read,
# with a deprecation warning.
# AZURE_STORAGE_CONNECTION_STRING=

# Optional. Blob container for the index files; default: the crawl id in lower
# case, e.g. cc-main-2022-40. --container overrides it.
# CC_CONTAINER=cc-main-2022-40

# Optional, default unified. The label-quality model of estimate_label_quality:
# unified, thesis or paper, the three checkpoints released in the
# label-quality-assurance repository (see pipeline/labelqa/MODEL.md). After a
# change, run the stage once with --rescore.
# LABELQA_MODEL=unified

# Optional. estimate_label_quality downloads the selected checkpoint (106 to
# 155 MB) on first use into ${XDG_CACHE_HOME:-~/.cache}/cortex/labelqa/ and
# loads it only when its SHA-256 matches (see pipeline/labelqa/MODEL.md).
# LABELQA_CHECKPOINT loads a local copy instead (verified the same way);
# LABELQA_CHECKPOINT_URL downloads from another URL, such as a mirror;
# LABELQA_CHECKPOINT_SHA256 replaces the expected hash, for another checkpoint
# of the selected model's network. The values below are the unified model's.
# LABELQA_CHECKPOINT=/path/to/best_ema_calibrated.pth
# LABELQA_CHECKPOINT_URL=https://labelqa.blob.core.windows.net/checkpoints/v1.0/unified__artifacts_voc__best_ema_calibrated.pth
# LABELQA_CHECKPOINT_SHA256=738531d0923755983ac7fb697c48f5d40ef23083b3dc6c37f3f78ef4b616b757
