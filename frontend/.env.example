# Cortex frontend configuration template.
#
#   cp .env.example .env.local
#
# Create React App reads these at `npm start` and inlines them at
# `npm run build`, so set them before building; changing them later needs a
# rebuild. They end up in the public JavaScript bundle: never put secrets here.
# All values here are placeholders.

# Optional, default empty. Base URL of the backend API.
# Empty: requests go to the SPA's own origin (/api/...), which is how the
# production build is served behind the reverse proxy.
# Local development with the Flask server on port 5000:
#   REACT_APP_API_URL=http://localhost:5000
REACT_APP_API_URL=

# Required for Google sign-in; without it only email and password login works.
# OAuth client id of the Google Identity Services web client, the same value
# as the backend's GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=
